# Copy this file to .env and edit it for your dataset and hardware.
# Values are Bash assignments; the pipeline sources this file.

# Output directory. Keep a different directory for each independent run.
CHECKPOINT_DIR="runs/my-first-model"
SEED="42"
PROMPT="Hello"

# Choose one pretraining source. With all three unset, Tiny Shakespeare is used.
# Local UTF-8 text:
# PRETRAIN_DATASET="data/corpus.txt"
# URL to a UTF-8 text file:
# PRETRAIN_DATASET_URL="https://example.org/corpus.txt"
# Hugging Face dataset:
# PRETRAIN_HF_DATASET="organization/dataset"
# PRETRAIN_HF_CONFIG="dataset-config"
# PRETRAIN_HF_SPLIT="train"
# PRETRAIN_VALIDATION_SPLIT="validation"
# TEXT_COLUMN="text"

# Resource and model settings. Tune these for available RAM/VRAM and corpus size.
BLOCK_SIZE="128"
BATCH_SIZE="4"
GRAD_ACCUM_STEPS="4"
N_LAYER="6"
N_HEAD="6"
N_EMBD="384"
EPOCHS="1"
MAX_STEPS="2000"
MAX_TOKENS="2000000"
MAX_VAL_TOKENS="20000"
LEARNING_RATE="0.0003"

# Resume only when intentionally continuing an existing pretraining run.
# RESUME_FROM="runs/my-first-model/ulysses-gpt-pretrain.pt"

# Optional SFT. Set the dataset ID to enable it; map columns to your dataset.
# SFT_HF_DATASET="organization/instruction-dataset"
# SFT_HF_CONFIG="dataset-config"
# SFT_HF_SPLIT="train"
# SFT_PROMPT_COLUMN="prompt"
# SFT_CONTEXT_COLUMN="context"
# RESPONSE_COLUMN="response"
# SFT_EPOCHS="1"
# SFT_MAX_SAMPLES="10000"
# SFT_LR="0.0001"

# Optional DPO. It starts from SFT output when SFT is enabled, otherwise
# from the pretrained checkpoint. Set the dataset ID to enable it.
# DPO_HF_DATASET="organization/preference-dataset"
# DPO_HF_CONFIG="dataset-config"
# DPO_HF_SPLIT="train"
# PROMPT_COLUMN="prompt"
# CHOSEN_COLUMN="chosen"
# REJECTED_COLUMN="rejected"
# DPO_EPOCHS="1"
# DPO_MAX_SAMPLES="10000"
# DPO_LR="0.000005"
